{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeckPlan",
  "type": "object",
  "required": ["schema_version", "slides"],
  "properties": {
    "schema_version": {"type": "string"},
    "deck": {"type": "object"},
    "status": {"type": "string"},
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide_id", "order", "role", "primary_message", "content_units", "status"],
        "properties": {
          "slide_id": {"type": "string", "pattern": "^OUT-S[0-9]{3}$"},
          "order": {"type": "integer", "minimum": 1},
          "role": {"type": "string"},
          "primary_message": {"type": "string", "minLength": 1},
          "content_units": {"type": "array", "items": {"type": "string"}},
          "importance": {"type": "string"},
          "optional": {"type": "boolean"},
          "status": {"type": "string"},
          "origin": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
