# Local UI
PORT=4317

# Optional. Defaults to `codex` on PATH.
# CODEX_BIN=/absolute/path/to/codex

# Optional image generation. Uploaded/local images work without this key.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# Optional endpoint override for compatible gateways.
# OPENAI_IMAGE_ENDPOINT=https://api.openai.com/v1/images/generations

# Test/demo only. Production UI should not silently use mock imagery.
IMAGE_OFFLINE_MOCK=0
