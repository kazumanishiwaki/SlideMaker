# Loopback App Server
NEXTGEN_PORT=4318

# Optional isolated run workspace.
# NEXTGEN_WORKSPACE=/absolute/path/to/workspace

# Optional bundled-runtime overrides.
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
# NEXTGEN_PYTHON=/absolute/path/to/python3

# Optional Codex App Server image-generation controls.
# NEXTGEN_CODEX_MODEL=gpt-5.6-sol
# NEXTGEN_IMAGE_EFFORT=low
# NEXTGEN_IMAGE_REVIEW_EFFORT=low
# NEXTGEN_IMAGE_MAX_ATTEMPTS=2
# NEXTGEN_CACHE=/absolute/path/to/cache

# Planning, page regeneration, and image generation use the signed-in Codex App
# Server. The current implementation accepts no provider API key or external
# image-generator command.
